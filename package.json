{
  "name": "sql-master",
  "productName": "SQL Master",
  "version": "0.1.0",
  "description": "Çok veritabanlı SQL istemcisi: bağlantı kütüphanesi, nesne ağacı, SQL editörü, görsel sorgu oluşturucu",
  "main": "dist-app/main/main.js",
  "author": "SQL Master",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "app.sqlmaster",
    "productName": "SQL Master",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist-app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@duckdb/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "SQL-Master-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SQL Master"
    },
    "portable": {
      "artifactName": "SQL-Master-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "mssql": "^12.7.9",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.6",
    "codemirror": "^6.0.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
